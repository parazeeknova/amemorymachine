# NOTE: committed root .env.development is the source of truth for local dev.
# This file only documents backy-specific vars. Copy root .env.example to root .env to override.

# Backend server port
PORT=7000

# Encryption key for sensitive stored data (github tokens, etc)
# Must be at least 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=change-me-to-a-random-secret

# PostgreSQL connection string
DATABASE_URL=postgres://amemorymachine:amemorymachine_dev_password@localhost:5432/amemorymachine?sslmode=disable

# Optional: Allowed web origins for CORS (comma-separated)
# Default: http://localhost:3000,http://localhost:7000
# WEB_ORIGIN=http://localhost:3000,http://localhost:7000

# Optional: Trusted proxy IPs for Gin (comma-separated)
TRUSTED_PROXIES=

# JWT access token signing secret (REQUIRED for auth)
# Must be at least 32 random bytes. Generate with: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-random-secret-of-length-32-or-more

# JWT settings
JWT_AUDIENCE=amemorymachine
JWT_ISSUER=amemorymachine

# Token time-to-live values
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookie settings
# COOKIE_SECURE defaults to true for non-localhost domains
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Optional: Override cookie names (defaults shown)
# ACCESS_TOKEN_COOKIE_NAME=amemorymachine_access_token
# REFRESH_TOKEN_COOKIE_NAME=amemorymachine_refresh_token

# RustFS version tag (default: latest)
# RUSTFS_VERSION=latest

# RustFS host ports (mapped in docker/docker-compose.infrastructure.yml)
# RUSTFS_PORT=6000
# RUSTFS_CONSOLE_PORT=6001

# RustFS S3 API endpoint
# Default for docker: http://amemorymachine-rustfs:9000
# Default for local dev without docker: http://localhost:6000
RUSTFS_ENDPOINT=http://localhost:6000

# RustFS console/web UI endpoint
# Default for docker: http://amemorymachine-rustfs:9001
# Default for local dev without docker: http://localhost:6001
RUSTFS_CONSOLE_ENDPOINT=http://localhost:6001

# RustFS S3 credentials
RUSTFS_ACCESS_KEY=amemorymachine
RUSTFS_SECRET_KEY=amemorymachine_dev_secret

# Optional: RustFS bucket name for amemorymachine uploads (default: amemorymachine)
# RUSTFS_BUCKET=amemorymachine

# Optional: Use path-style S3 URLs (default: true for local dev)
# RUSTFS_PATH_STYLE=true

# VAPID keys for Web Push notifications
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@amemorymachine.cc

# Unsplash API Access Key for header image search
# Create an app at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

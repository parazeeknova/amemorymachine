{
  "name": "@amemorymachine/backy",
  "version": "0.7.46",
  "private": true,
  "scripts": {
    "build": "go build -o bin/backy",
    "check": "./scripts/check.sh",
    "check-types": "go vet ./...",
    "db:migrate": "dotenv -e ../../.env -e ../../.env.development -- go run ./database/cmd/migrate up",
    "db:reset": "dotenv -e ../../.env -e ../../.env.development -- go run ./database/cmd/migrate reset",
    "dev": "dotenv -e ../../.env -e ../../.env.development -- go run main.go",
    "format": "./scripts/format.sh",
    "start": "./bin/backy",
    "test": "go test ./...",
    "test:coverage": "go test ./... -cover"
  }
}

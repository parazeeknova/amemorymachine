# NOTE: committed root .env.development is the source of truth for local dev.
# This file only documents weby-specific vars. Copy root .env.example to root .env to override.

# Backy API URL (the Go backend)
# For local development: http://localhost:7000
# For production: https://your-backy-instance.example.com
BACKY_ORIGIN=

# Public origin used for canonical URLs, sitemap.xml, robots.txt and llms.txt.
# For local development this is unset (the request origin is used instead).
# For production set it to the deployed domain, e.g. https://amemorymachine.cc
VITE_APP_ORIGIN=

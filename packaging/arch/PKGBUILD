# Maintainer: Harsh Sahu <harsh@itssingularity.com> (Singularity Works - itssingularity.com)
pkgname=amemorymachine-bin
pkgver=0.7.53
pkgrel=1
pkgdesc="Self-hosted markdown editor with second-brain capabilities"
arch=('x86_64')
url="https://github.com/parazeeknova/amemorymachine"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'libayatana-appindicator3' 'glib-networking')
optdepends=('gstreamer: audio/video support'
            'gst-plugins-base: audio/video support'
            'gst-plugins-good: audio/video support'
            'gst-plugins-bad: WebVTT subtitles and video support')
provides=('amemorymachine')
conflicts=('amemorymachine')
source=("https://github.com/parazeeknova/amemorymachine/releases/download/v${pkgver}/stable-linux-x64-Amemorymachine-Setup.tar.gz")
sha256sums=('3211382b424c164f4d79cf9eec0a025541fcbbbf5837a2641984eb958fbf47dc')

package() {
    # Install application files
    install -d "${pkgdir}/opt/amemorymachine"
    cp -r "${srcdir}/stable-linux-x64-Amemorymachine-Setup/"* "${pkgdir}/opt/amemorymachine/"
    
    # Create symlink in bin
    install -d "${pkgdir}/usr/bin"
    ln -s "/opt/amemorymachine/Amemorymachine" "${pkgdir}/usr/bin/amemorymachine"

    # Add .desktop and icon
    install -d "${pkgdir}/usr/share/applications"
    cat << EOF > "${pkgdir}/usr/share/applications/amemorymachine.desktop"
[Desktop Entry]
Name=Amemorymachine
Exec=amemorymachine
Icon=/opt/amemorymachine/resources/amemorymachine.png
Type=Application
Categories=Utility;
Terminal=false
Comment=Self-hosted markdown editor with second-brain capabilities
EOF
}
